{
  "name": "@bluewombat/slots",
  "version": "0.9.0",
  "type": "module",
  "description": "Shipped mason slots: Builders, Gates, publishers, and refreshers a Project names in its config.",
  "keywords": [
    "mason",
    "bluewombat",
    "gate",
    "builder"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tilap/bluewombat/tree/main/packages/plugins/slots#readme",
  "bugs": "https://github.com/tilap/bluewombat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilap/bluewombat.git",
    "directory": "packages/plugins/slots"
  },
  "exports": {
    "./builders/*": "./builders/*",
    "./ticket/*": "./ticket/*",
    "./feature/*": "./feature/*",
    "./agents/*": "./agents/*",
    "./gates/*": "./gates/*",
    "./publishers/*": "./publishers/*",
    "./refreshers/*": "./refreshers/*",
    "./messages/*": "./messages/*"
  },
  "files": [
    "builders",
    "ticket",
    "feature",
    "agents",
    "lib",
    "gates",
    "README.md",
    "publishers",
    "refreshers",
    "messages"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "tsc": "tsc --noEmit",
    "test": "tsx --test $(find test -name '*.test.ts')"
  },
  "dependencies": {
    "@bluewombat/slot-kit": "^0.9.0",
    "@pinkpuma/deck": "1.1.0"
  }
}
