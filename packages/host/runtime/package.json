{
  "name": "@bluewombat/runtime",
  "version": "0.1.2",
  "type": "module",
  "description": "The mason process: listen, admit, run Conductor, report. Loads one FeatureManager plugin.",
  "keywords": [
    "mason",
    "bluewombat",
    "cli",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tilap/bluewombat/tree/main/packages/host/runtime#readme",
  "bugs": "https://github.com/tilap/bluewombat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilap/bluewombat.git",
    "directory": "packages/host/runtime"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mason": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPECS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "tsc": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bluewombat/conductor": "^0.1.2",
    "@bluewombat/feature-breakdown": "^0.1.2",
    "@bluewombat/manager-kit": "^0.1.2",
    "@bluewombat/implementer": "^0.1.2",
    "@bluewombat/integrator": "^0.1.2",
    "@bluewombat/isolation-copy": "^0.1.2",
    "@bluewombat/isolation-git": "^0.1.2",
    "@bluewombat/isolator": "^0.1.2",
    "@bluewombat/slots": "^0.1.2",
    "@bluewombat/work-ledger": "^0.1.2",
    "@bluewombat/persist-fs": "^0.1.2"
  },
  "devDependencies": {
    "@bluewombat/manager-fake": "^0.1.2",
    "@bluewombat/manager-github": "^0.1.2",
    "@bluewombat/persist-sqlite": "^0.1.2"
  }
}
